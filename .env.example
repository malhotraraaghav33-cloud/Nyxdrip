# Frontend Client Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Edge Functions Secrets (Set via: supabase secrets set KEY=VALUE)
# Razorpay Configuration (Test / Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_ENVIRONMENT=test

# PayPal Configuration (Sandbox / Live)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Optional Email Dispatch (Resend / SMTP)
RESEND_API_KEY=re_your_api_key_here

# Vercel Razorpay preview test-only gateway
# Configure on Vercel PREVIEW deployment only, not Production.
RAZORPAY_TEST_MODE_ENABLED=false
VITE_RAZORPAY_TEST_MODE_ENABLED=false
# RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET above are server-only.

# NYXDRIP live Razorpay checkout (Vercel server-side settings)
# DO NOT flip live flags until merchant approval, migrations, and payment tests pass.
# Use a newly generated key; never paste actual secrets into GitHub or chat.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_SERVER_ONLY_service_role_key
RAZORPAY_LIVE_ENABLED=false
VITE_RAZORPAY_LIVE_ENABLED=false
# Required for signed live webhook endpoint; server-only:
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
